+      longitude: proposal.longitude + 0.08,
+      latitude: proposal.latitude + 0.04,
+    };
+  }
+  if (label !== "released") {
+    // Programmatic feedback arrives before the first poll but retains the actual user event.
+    state.actual = state.controlled
+      ? { ...clone(state.controlled), ...(state.clamp ? { zoom: 3 } : {}) }
+      : clone(state.actual);
+    state.viewState = clone(state.actual);
+    state.events.moves += 1;
+    state.events.origin = "programmatic";
+  } else {
+    // Uncontrolled native inertia can move beyond the last direct user sample.
+    state.actual.longitude += 0.08;
+    state.actual.latitude += 0.04;
