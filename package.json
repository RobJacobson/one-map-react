{
  "name": "one-map-react-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.1",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "biome check .",
    "format": "biome format --write .",
    "check:docs": "bun scripts/check-docs.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.examples.web.json && tsc --noEmit -p tsconfig.examples.native.json",
    "build": "bun scripts/build.mjs",
    "test": "jest --runInBand && bun examples/mapbox-token.test.mjs",
    "test:peers": "bun run build && bun scripts/test-peers.mjs",
    "test:package": "bun run build && bun scripts/test-package.mjs",
    "test:example-resolution": "bun run build && bun scripts/test-example-resolution.mjs",
    "validate": "bun run check && bun run check:docs && bun run typecheck && bun run test && bun run test:package",
    "pack": "bun run build && mkdir -p artifacts && cd packages/one-map-react && bun pm pack --destination ../../artifacts --ignore-scripts"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/runtime": "7.25.0",
    "@biomejs/biome": "2.5.15",
    "@maplibre/maplibre-react-native": "11.5.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@rnmapbox/maps": "10.3.7",
    "@testing-library/react": "16.3.3",
    "@testing-library/react-native": "14.1.0",
    "@types/geojson": "7946.0.16",
    "@jest/globals": "29.7.0",
    "@types/jest": "29.5.14",
    "@types/jsdom": "30.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jsdom": "30.1.2",
    "mapbox-gl": "3.32.0",
    "maplibre-gl": "6.13.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-map-gl": "8.1.3",
    "react-native": "0.87.1",
    "test-renderer": "1.3.0",
    "typescript": "7.0.2"
  }
}
