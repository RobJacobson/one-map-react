# Public Mapbox token (pk.) for the Mapbox examples.
# The shell variable MAPBOX_ACCESS_TOKEN overrides this file.
# Do not put a secret token here. The examples embed this value in the local bundle.
MAPBOX_ACCESS_TOKEN=

# Shared public token for apps/expo and apps/web. When omitted, those apps also
# accept MAPBOX_ACCESS_TOKEN above. An explicit empty value disables Mapbox.
# EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Development-only Expo camera readback panel. Vite uses ?test=1 instead.
# EXPO_PUBLIC_ONE_MAP_TEST_MODE=1
