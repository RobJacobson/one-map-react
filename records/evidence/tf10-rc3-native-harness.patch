+
+const base = { longitude: 0, latitude: 0, zoom: 2, bearing: 0, pitch: 0 };
+assertFiniteCamera({ ...base, zoom: 3 });
+assertCameraRead({ moves: 1, ends: 0, origin: "user", userMoves: 1, userEnds: 0, lastUserOrigin: "user", lastUserViewState: base, center: [0, 0], zoom: 3, bearing: 0, pitch: 0, controlled: base, viewState: base });
