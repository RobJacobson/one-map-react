{
  "name": "@one-map/expo",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "57.0.17",
    "@expo/ui": "57.0.25",
    "@maplibre/maplibre-react-native": "11.5.0",
    "@one-map/example-map": "workspace:*",
    "@rnmapbox/maps": "10.3.8",
    "expo": "57.0.23",
    "expo-build-properties": "57.0.22",
    "expo-dev-client": "57.0.20",
    "mapbox-gl": "3.32.0",
    "maplibre-gl": "6.13.0",
    "one-map-react": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-map-gl": "8.1.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-teleport": "1.2.1",
    "react-native-web": "0.21.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "babel-preset-expo": "57.0.12"
  },
  "scripts": {
    "dev": "bun run prepare:worker && expo start --dev-client --port 8081",
    "build:web": "bun run prepare:worker && expo export --platform web",
    "ios": "expo run:ios --no-bundler",
    "android": "expo run:android --no-bundler",
    "prepare:worker": "mkdir -p public && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs public/maplibre-gl-worker.mjs"
  },
  "private": true
}
