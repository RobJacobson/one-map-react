{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "paths": {
      "@rnmapbox/maps": [
        "./node_modules/@rnmapbox/maps/lib/typescript/src/Mapbox.native.d.ts"
      ],
      "one-map-react": ["./packages/one-map-react/src/index.ts"],
      "one-map-react/mapbox-native": [
        "./packages/one-map-react/src/mapbox-native.tsx"
      ],
      "one-map-react/maplibre-native": [
        "./packages/one-map-react/src/maplibre-native.tsx"
      ]
    }
  },
  "include": [
    "packages/example-map/src/scenarios/route-map.tsx",
    "packages/example-map/src/scenarios/tf08-map.tsx",
    "packages/example-map/src/scenarios/lifecycle-smoke.ts",
    "packages/example-map/src/scenarios/camera-smoke.ts",
    "packages/example-map/src/scenarios/native-camera-screen.tsx",
    "packages/example-map/test/selection/**/setup.native.ts",
    "packages/example-map/src/scenarios/mapbox-native.tsx",
    "packages/example-map/src/scenarios/maplibre-native.tsx",
    "packages/example-map/src/scenarios/native-*.tsx"
  ]
}
