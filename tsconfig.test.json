{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["jest"],
    "resolveJsonModule": true,
    "paths": {
      "one-map-react": ["./packages/one-map-react/src/index.ts"],
      "@rnmapbox/maps": [
        "./node_modules/@rnmapbox/maps/lib/typescript/src/Mapbox.native.d.ts"
      ]
    }
  },
  "include": [
    "packages/one-map-react/src/**/*.ts",
    "packages/one-map-react/src/**/*.tsx",
    "packages/one-map-react/test/**/*.ts",
    "packages/one-map-react/test/**/*.tsx"
  ]
}
